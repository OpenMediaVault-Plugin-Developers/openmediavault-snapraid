msgstr "ແກ້ໄຂໄດຣຟ໌."

msgid "Edit rule."
msgstr "ແກ້ໄຂກົດ."

msgid "Edit scheduled diff."
msgstr "ແກ້ໄຂການຕັ້ງເວລາ Diff."

msgid "Empty Dir"
msgstr "ໂຟນເດີວ່າງ"

msgid "Excludes hidden files and directories."
msgstr "ຍົກເວັ້ນໄຟລ໌ ແລະ ໂຟນເດີທີ່ຖືກເຊື່ອງໄວ້."

msgid "Exclusion"
msgstr "ການຍົກເວັ້ນ"

msgid "Fix"
