msgid "A config file for this array does not exist."
msgstr "ບໍ່ມີໄຟລ໌ກຳນົດຄ່າສຳລັບອາເຣນີ້."

msgid "A data drive cannot be a parity drive."
msgstr "ໄດຣຟ໌ຂໍ້ມູນບໍ່ສາມາດເປັນໄດຣຟ໌ພາຣິຕີ້ໄດ້."

msgid ""
"Are you sure you want to force a full sync? This will recompute all parity "
"blocks from scratch and may take a very long time."
msgstr "ເຈົ້າແນ່ໃຈບໍວ່າຕ້ອງການບັງຄັບໃຫ້ຊິງຄ໌ຂໍ້ມູນທັງໝົດ? ສິ່ງນີ້ຈະຄຳນວນບລັອກພາຣິຕີ້ໃໝ່ທັງໝົດແຕ່ເລີ່ມຕົ້ນ ແລະ ອາດຈະໃຊ້ເວລາດົນຫຼາຍ."

msgid ""
"Are you sure you want to redirect this data drive to an empty directory in "
"the snapraid config? Apply settings afterwards, then run 'Force Empty Sync' "
"on the array."
msgstr "ເຈົ້າແນ່ໃຈບໍວ່າຕ້ອງການປ່ຽນເສັ້ນທາງໄດຣຟ໌ຂໍ້ມູນນີ້ໄປຫາໂຟນເດີວ່າງໃນການກຳນົດຄ່າ SnapRAID? ໃຫ້ກົດນຳໃຊ້ການຕັ້ງຄ່າຫຼັງຈາກນັ້ນ, ແລ້ວແລ່ນ 'Force Empty Sync' ໃນອາເຣ."

msgid ""
"Are you sure you want to restore this drive to its original mount path? "
"Apply settings afterwards to update the snapraid config."
msgstr "ເຈົ້າແນ່ໃຈບໍວ່າຕ້ອງການກູ້ຄືນໄດຣຟ໌ນີ້ໄປຫາເສັ້ນທາງການເມົາທ໌ (mount) ເດີມ? ໃຫ້ກົດນຳໃຊ້ການຕັ້ງຄ່າຫຼັງຈາກນັ້ນເພື່ອອັບເດດການກຳນົດຄ່າ SnapRAID."

msgid ""
"Are you sure you want to run Force Empty Sync? Use this after setting a data"
" drive to an empty directory and applying settings. SnapRAID will update "
"parity to reflect the now-empty drive."
msgstr "ເຈົ້າແນ່ໃຈບໍວ່າຕ້ອງການແລ່ນ Force Empty Sync? ໃຊ້ສິ່ງນີ້ຫຼັງຈາກຕັ້ງຄ່າໄດຣຟ໌ຂໍ້ມູນໃຫ້ເປັນໂຟນເດີວ່າງ ແລະ ນຳໃຊ້ການຕັ້ງຄ່າແລ້ວ. SnapRAID ຈະອັບເດດພາຣິຕີ້ເພື່ອສະແດງໃຫ້ເຫັນວ່າໄດຣຟ໌ວ່າງແລ້ວ."

msgid "Array"
msgstr "ອາເຣ"

msgid "Array config."
msgstr "ການກຳນົດຄ່າອາເຣ."

msgid "Arrays"
msgstr "ອາເຣ"

msgid "Auto save"
msgstr "ບັນທຶກອັດຕະໂນມັດ"

msgid ""
"Automatically save the state when syncing after the specified amount of GiB "
"is processed. Default value is 0, meaning disabled."
msgstr "ບັນທຶກສະຖານະໂດຍອັດຕະໂນມັດເມື່ອຊິງຄ໌ຂໍ້ມູນຫຼັງຈາກປະມວນຜົນຕາມຈຳນວນ GiB ທີ່ກຳນົດ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 0, ໝາຍເຖິງປິດການໃຊ້ງານ."

msgid "Block size"
msgstr "ຂະໜາດບລັອກ"

msgid "Block size in KiB"
msgstr "ຂະໜາດບລັອກເປັນ KiB"

msgid "Check"
msgstr "ກວດສອບ"

msgid "Check - Audit only"
msgstr "ກວດສອບ - ສະເພາະການກວດສອບບັນຊີ"

msgid "Component"
msgstr "ສ່ວນປະກອບ"

msgid "Config"
msgstr "ກຳນົດຄ່າ"

msgid "Content"
msgstr "ເນື້ອຫາ"

msgid "Create"
msgstr "ສ້າງ"

msgid "Created array."
msgstr "ສ້າງອາເຣແລ້ວ."

msgid "Created drive."
msgstr "ສ້າງໄດຣຟ໌ແລ້ວ."

msgid "Created rule."
msgstr "ສ້າງກົດແລ້ວ."

msgid ""
"Creates symlink from array config file to /etc/snapraid.conf allowing "
"snapraid commands to work on default array without specifying the config "
"file flag"
msgstr "ສ້າງ symlink ຈາກໄຟລ໌ກຳນົດຄ່າອາເຣໄປຫາ /etc/snapraid.conf ເພື່ອໃຫ້ຄຳສັ່ງ snapraid ເຮັດວຽກກັບອາເຣເລີ່ມຕົ້ນໄດ້ໂດຍບໍ່ຕ້ອງລະບຸ flag ໄຟລ໌ກຳນົດຄ່າ"

msgid "Data"
msgstr "ຂໍ້ມູນ"

msgid "Date & Time"
msgstr "ວັນທີ ແລະ ເວລາ"

msgid "Debug"
msgstr "ດີບັກ"

msgid ""
"Define threshold of deleted files above which not to start the sync process."
" default = 0 to disable this check and always sync."
msgstr "ກຳນົດເກນຂອງໄຟລ໌ທີ່ຖືກລຶບ ຫາກເກີນຄ່ານີ້ຈະບໍ່ເລີ່ມຂະບວນການຊິງຄ໌. ຄ່າເລີ່ມຕົ້ນ = 0 ເພື່ອປິດການກວດສອບນີ້ ແລະ ຊິງຄ໌ຕະຫຼອດ."

msgid ""
"Define threshold of updated files above which not to start the sync process."
" default = 0 to disable this check and always sync."
msgstr "ກຳນົດເກນຂອງໄຟລ໌ທີ່ຖືກອັບເດດ ຫາກເກີນຄ່ານີ້ຈະບໍ່ເລີ່ມຂະບວນການຊິງຄ໌. ຄ່າເລີ່ມຕົ້ນ = 0 ເພື່ອປິດການກວດສອບນີ້ ແລະ ຊິງຄ໌ຕະຫຼອດ."

msgid "Delete threshold"
msgstr "ເກນການລຶບ"

msgid "Devices"
msgstr "ອຸປະກອນ"

msgid "Diff"
msgstr "ດິຟ (Diff)"

msgid "Diff script settings"
msgstr "ການຕັ້ງຄ່າສະຄຣິບ Diff"

msgid "Docs"
msgstr "ເອກະສານ"

msgid "Down"
msgstr "ລົງ"

msgid ""
"Drive where content file is stored.  This file is a list of saved files and "
"contains the details of your backup with all the checksums to verify its "
"integrity."
msgstr "ໄດຣຟ໌ທີ່ເກັບໄຟລ໌ເນື້ອຫາ. ໄຟລ໌ນີ້ແມ່ນລາຍຊື່ຂອງໄຟລ໌ທີ່ບັນທຶກໄວ້ ແລະ ປະກອບມີລາຍລະອຽດຂອງການສຳຮອງຂໍ້ມູນຂອງທ່ານພ້ອມກັບ checksum ທັງໝົດເພື່ອຢືນຢັນຄວາມຖືກຕ້ອງ."

msgid "Drive where data is stored."
msgstr "ໄດຣຟ໌ທີ່ເກັບຂໍ້ມູນ."

msgid ""
"Drive where parity files are stored which are necessary to recover from disk"
" failure.  For each parity drive, one data drive can fail without data loss."
msgstr "ໄດຣຟ໌ທີ່ເກັບໄຟລ໌ພາຣິຕີ້ ເຊິ່ງຈຳເປັນສຳລັບການກູ້ຄືນຈາກຄວາມເສຍຫາຍຂອງດິສກ໌. ສຳລັບແຕ່ລະໄດຣຟ໌ພາຣິຕີ້, ໄດຣຟ໌ຂໍ້ມູນໜຶ່ງໜ່ວຍສາມາດເສຍຫາຍໄດ້ໂດຍຂໍ້ມູນບໍ່ສູນຫາຍ."

msgid "Drives"
msgstr "ໄດຣຟ໌"

